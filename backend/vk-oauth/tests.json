{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "action=status без VK_GROUP_ID работает",
      "method": "GET",
      "path": "/?action=status",
      "expectedStatus": 200
    },
    {
      "name": "Маркет: status без feed_id — 400",
      "method": "GET",
      "path": "/?module=market&action=status",
      "expectedStatus": 400
    },
    {
      "name": "Маркет: POST без прав — 403",
      "method": "POST",
      "path": "/?module=market",
      "body": {
        "feed_id": 1
      },
      "expectedStatus": 403
    },
    {
      "name": "Реклама: OPTIONS",
      "method": "OPTIONS",
      "path": "/?module=ads",
      "expectedStatus": 200
    }
  ]
}