{
  "tests": [
    {
      "name": "Проверка здоровья площадок",
      "method": "GET",
      "path": "/?action=sync_health",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Кабинет Яндекс.Недвижимости",
      "method": "GET",
      "path": "/?action=yandex_stats",
      "expectedStatus": 200
    },
    {
      "name": "Площадки «Разное»",
      "method": "GET",
      "path": "/?action=other_platforms",
      "expectedStatus": 200
    },
    {
      "name": "Сводка XML-файла Юлы",
      "method": "GET",
      "path": "/?action=youla_feed",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Состояние площадок",
      "method": "GET",
      "path": "/?action=platform_state",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Выключение площадки без прав",
      "method": "POST",
      "path": "/?action=platform_toggle",
      "body": {
        "platform": "youla",
        "off": true
      },
      "expectedStatus": 403
    },
    {
      "name": "Неизвестное действие",
      "method": "GET",
      "path": "/?action=nope",
      "expectedStatus": 400
    }
  ]
}