{
  "tests": [
    {
      "name": "Без токена",
      "method": "GET",
      "path": "/?resource=listings",
      "expectedStatus": 401
    },
    {
      "name": "Приём ошибки без авторизации (SMTP не настроен)",
      "method": "POST",
      "path": "/?resource=error_report",
      "body": {
        "message": "Test error",
        "url": "https://example.com/news/test",
        "stack": "Error: test",
        "userAgent": "Mozilla/5.0"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "sent": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Matching без токена",
      "method": "GET",
      "path": "/?resource=matching&type=leads_for_listing&id=1",
      "expectedStatus": 401
    },
    {
      "name": "Заявки на выгрузку без токена",
      "method": "GET",
      "path": "/?resource=export_requests",
      "expectedStatus": 401
    },
    {
      "name": "Шаблоны баннера без токена",
      "method": "GET",
      "path": "/?resource=qr_banner_templates",
      "expectedStatus": 401
    },
    {
      "name": "Создание шаблона без токена",
      "method": "POST",
      "path": "/?resource=qr_banner_templates",
      "body": {
        "name": "x",
        "width_cm": 100,
        "height_cm": 40
      },
      "expectedStatus": 401
    },
    {
      "name": "Удаление шаблона без токена",
      "method": "DELETE",
      "path": "/?resource=qr_banner_templates&id=1",
      "expectedStatus": 401
    }
  ]
}